# ── Deriv API (for live tick collection via WebSocket) ─────────────────
# A public Deriv app ID reads market data without an API token.
# Set this to enable live ticks via Deriv WebSocket (no MT5 needed).
DERIV_APP_ID=your_app_id

# ── MT5 / Deriv (for terminal-connected live ticks + execution) ──
# Set these to connect to your running Deriv MT5 terminal.
# The system tries MT5 FIRST when these are set. If MT5 fails (e.g. the
# terminal isn't reachable via IPC), it falls back to Deriv WebSocket.
SYNTHETIC_MT5_SERVER=
SYNTHETIC_MT5_LOGIN=
SYNTHETIC_MT5_PASSWORD=

# ── MT5 optional overrides ───────────────────────────────────────────
# Path to terminal64.exe (auto-detected if not set)
SYNTHETIC_MT5_TERMINAL_PATH=
# Custom symbol name mapping (e.g. R_75:MySymbol,R_100:MyOther)
#SYNTHETIC_MT5_SYMBOL_MAP=

# ── Python engine root (usually auto-detected) ───────────────────────
SYNTHETIC_ENGINE_ROOT=C:\Users\USER\Desktop\Projects\Synthetic Indices Bot

# ── Warmup interval ──────────────────────────────────────────────────
# Number of CSV ticks to scan in each warmup cycle (default 5)
SYNTHETIC_ENGINE_MAX_LIVE_TICKS=15

# ── Prop firm defaults ──────────────────────────────────────────────
SYNTHETIC_PROP_STARTING_BALANCE=5000
