; MITEMSHUB AI v26.32 — Volatility 75 FINAL profile (PAPER MODE)
; Regenerated 2026-09-04 on the 210-day walk-forward result (round 3).
;
; v26.32 STRATEGY (scripts/walkforward_v75.py round 3, 26 folds x 8d,
; 508 trades, artifact walkforward_210d.json):
;   InpTpMult 1.8 alone: +52.4R total, t=1.68, 15/26 folds positive — the
;   best config. Legacy (TP 2.4): +51.4R, t=1.57.
;   The v26.29 static stack (EMA-side veto + pb-min 0.60) measured only
;   +18.3R on the same folds — a ~33R drag vs legacy; it was curve-fit to
;   August and is now OFF. The family throttle adds nothing (+50.4R).
;   Caveat: all candidates failed the strict 60%-positive-folds bar — the
;   edge is modest and choppy. The paper run is the final gate.
;
; R_75 validated band geometry:
;   z=2.0, stop=0.10x sigma_h, target=1.20x sigma_h
;   trailing ON (0.7R dist), breakeven ON at 1R
;
; Magic 7788075 — fleet exposure guard compliant.
InpUsePullback=true
InpUseBreakout=false
InpUseMomentum=true
InpUseMeanRevert=true
InpUseBandFade=false
InpMinScore=3
InpRequire2Strats=false
InpMomentumStandalone=false
InpEmaFast=20
InpEmaMid=50
InpEmaSlow=100
InpMinEmaSep=0.20
InpAtrPeriod=14
InpAtrLookback=200
InpAtrLowPct=10.0
InpAtrHighPct=92.0
InpPullbackMin=0.30
InpPullbackMax=2.2
InpBreakoutBuffer=0.10
InpBreakoutBars=12
InpMomBodyMin=0.45
InpRsiOversold=32.0
InpRsiOverbought=68.0
InpPbEmaSideVeto=false
InpBandZEntry=2.0
InpBandVolExtRatio=1.25
InpBandSigmaEmaLen=30
InpBandStopSigmaMult=0.10
InpBandTargetSigmaMult=1.20
InpBandHoldSec=3600
InpBandMinRR=2.5
InpBandMaxStopPct=0.015
InpRiskPerTrade=0.005
InpMaxEffectiveRiskPct=20.0
InpTpMult=1.8
InpMaxHoldBars=20
InpMaxDailyLossPct=0.0
InpMaxConsecLoss=3
InpCoolDownBars=3
InpUseTrailing=true
InpTrailStartR=1.0
InpTrailDistR=0.7
InpUseBreakeven=true
InpBeTriggerR=1.0
; v26.28 PAPER MODE — virtual fills at live bid/ask, InpPaperEquity drives sizing
; (the 20% real-risk cap, loss-streak scaling, and compounding all run on the
; funded scenario). $50 matches the certification harness; raise to the target
; funded size when that account's paper validation is the goal.
InpPaperEquity=50.0
InpPaperSpreadMult=1.5
; v26.30 min-lot risk router: refuses entries when the broker minimum lot cannot
; hold the risk cap (tiny accounts), and prints which instruments DO fit.
InpFitRouter=true
InpRouterScanATR=1.7
InpEntryTFOverride=M15
InpRegimeTFOverride=H1
InpMagic=7788075
InpMaxSlippagePts=40
InpWarmupBars=150
InpDrawDashboard=true
InpDrawSignals=true
InpLiveExecution=false
InpMaxTradesPerDay=9999
; Account-wide exposure guard
InpMaxTotalRiskPct=15.0
InpFleetMagicsCSV=7788010,7788025,7788050,7788075,7788100
; v23 Intelligence & Safety
InpSessionStartHour=0
InpSessionEndHour=0
InpSameSymbolMaxPos=1
InpGraduatedExit=true
InpEarlyCutBars=6
InpEarlyCutMaxR=-0.4
InpExtendWinMult=1.5
InpScaleAfterLoss=true
InpScaleFactor=0.75
InpMinVolScale=0.30
InpProfitLockR=0.5

; v26.17: burst-fade leg stays OFF until replay-validated on recorded Vol ticks
InpVolBurstFade=false
InpWinRearm=true
InpMaxSpreadATRFrac=0.18
InpAdaptiveConviction=true
