//+------------------------------------------------------------------+
//|                                        Tests/Phase10Tests.mq5     |
//|  MITEMSHUB AI MARKET ENGINE — Phase 10 step-1 unit tests.        |
//|                                                                  |
//|  Locks the two Market/ modules extracted from BandBackTests so   |
//|  the production EA does not depend on a test suite:              |
//|    CGarchForecaster — the EGARCH(1,1) estimator.  Reference      |
//|      sigmas are LOCKED: mode 1 (calibrated-fixed, the production |
//|      estimator) against a fixed-params replication, and mode 0   |
//|      (online-SGD) against the REAL Python EGARCHVarianceFore-    |
//|      caster run over the identical literal return sequence       |
//|      (mql5/phase10_garch_reference.py, which self-validates its  |
//|      mode-0 replication against the actual model before print-   |
//|      ing).  Any divergence > 1e-9 relative fails the suite.      |
//|    CBarAggregator — the tick->closed-bar bucketter matching the  |
//|      Python CandleBuilder convention: floor-bucket OHLC, exactly-|
//|      once bar close on bucket crossing, multi-bucket jumps       |
//|      fabricate no empty bars, stale ticks ignored, Reset clears. |
//+------------------------------------------------------------------+
#property strict
#property copyright "Synthetic Indices Bot"
#property version   "1.00"
#property description "MITEMSHUB Phase 10 step-1 unit tests — GarchForecaster + BarAggregator"

#include "../Core/Constants.mqh"
#include "../Market/GarchForecaster.mqh"
#include "../Market/BarAggregator.mqh"

int g_pass = 0;
int g_fail = 0;

void Check(const string name, const bool ok, const string detail = "")
  {
   if(ok)
     {
      g_pass++;
      Print("[PHASE10] PASS  ", name);
     }
   else
     {
      g_fail++;
      Print("[PHASE10] FAIL  ", name, detail != "" ? "  -> " + detail : "");
     }
  }

bool CloseEnough(const double a, const double b, const double tol = 1e-9)
  {
   double scale = MathMax(MathMax(MathAbs(a), MathAbs(b)), 1e-30);
   return(MathAbs(a - b) <= tol * scale);
  }

