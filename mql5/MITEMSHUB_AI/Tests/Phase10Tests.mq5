//+------------------------------------------------------------------+
//| TestGarchWarmup — <30 obs gate, sigma = sqrt(long_run_variance)  |
//+------------------------------------------------------------------+
void TestGarchWarmup()
  {
   Print("[PHASE10] --- GarchForecaster warmup ---");
   CGarchForecaster f(1);   // calibrated-fixed, default params
   double sigma = 0.0;
   for(int i = 0; i < 29; i++)
     {
      bool ready = f.Update(0.001, sigma);
      Check("warmup update " + IntegerToString(i + 1) + " not ready",
            !ready, "sigma=" + DoubleToString(sigma, 10));
      Check("warmup sigma == sqrt(long_run_var) == 0.02",
            CloseEnough(sigma, 0.02, 1e-12), "sigma=" + DoubleToString(sigma, 12));
     }
   Check("observations == 29", f.Observations() == 29);
   bool ready = f.Update(0.001, sigma);
   Check("obs 30 recursion ready", ready);
   // NOTE: the warmup sequence feeds 0.001 (not G_REF_RETURNS[29]), so there
   // is no locked reference value here — the exact-number lock lives in
   // TestGarchLocked.  A mild return must decay sigma below the 0.02 long-run.
   Check("obs 30 sigma decays below long-run after a mild return",
         sigma > 0.01 && sigma < 0.02, "sigma=" + DoubleToString(sigma, 14));
  }

//+------------------------------------------------------------------+
//| TestGarchLocked — the cross-language EGARCH lock                 |
//+------------------------------------------------------------------+
void TestGarchLocked()
  {
   Print("[PHASE10] --- GarchForecaster locked reference sigmas ---");
   CGarchForecaster m1(1, -1.115, 0.077, 0.011, 0.918);   // calibrated R_75
   double sigma = 0.0;
   int diffs = 0;
   for(int i = 0; i < 80; i++)
     {
      m1.Update(G_REF_RETURNS[i], sigma);
      if(!CloseEnough(sigma, G_REF_SIGMA_M1[i], 1e-9))
        {
         diffs++;
         if(diffs <= 3)
            Print("  [mode1] i=", IntegerToString(i), " got=", DoubleToString(sigma, 14),
                  " ref=", DoubleToString(G_REF_SIGMA_M1[i], 14));
        }
     }
   Check("mode-1 sigmas match locked reference (all 80)",
         diffs == 0, IntegerToString(diffs) + " diffs");

   CGarchForecaster m0(0);   // online-SGD — real Python forecaster lock
   diffs = 0;
   for(int i = 0; i < 80; i++)
     {
      m0.Update(G_REF_RETURNS[i], sigma);
      if(!CloseEnough(sigma, G_REF_SIGMA_M0[i], 1e-9))
        {
         diffs++;
         if(diffs <= 3)
            Print("  [mode0] i=", IntegerToString(i), " got=", DoubleToString(sigma, 14),
                  " ref=", DoubleToString(G_REF_SIGMA_M0[i], 14));
        }
     }
   Check("mode-0 sigmas match real Python forecaster (all 80)",
         diffs == 0, IntegerToString(diffs) + " diffs");

   Check("mode 0 and mode 1 diverge (SGD blowup vs calibrated decay)",
         !CloseEnough(G_REF_SIGMA_M0[79], G_REF_SIGMA_M1[79], 1e-3),
         "m0=" + DoubleToString(G_REF_SIGMA_M0[79], 6) + " m1=" + DoubleToString(G_REF_SIGMA_M1[79], 6));
  }

//+------------------------------------------------------------------+
//| TestGarchDeterminism — two instances identical; Reset restores    |
//+------------------------------------------------------------------+
void TestGarchDeterminism()
  {
   Print("[PHASE10] --- GarchForecaster determinism + reset ---");
   CGarchForecaster a(1), b(1);
   double sa = 0.0, sb = 0.0;
   bool same = true;
   for(int i = 0; i < 200; i++)
     {
      double r = (i % 7 == 0) ? 0.01 : ((i % 5 == 0) ? -0.006 : 0.0004);
      a.Update(r, sa);
      b.Update(r, sb);
      if(!CloseEnough(sa, sb, 1e-12))
         same = false;
     }
   Check("two identical forecasters identical after 200 updates", same);
   Check("sigma finite and sane after 200 updates", sa > 1e-6 && sa < 1.0);

   CGarchForecaster c(1);
   c.Update(0.001, sa);
   c.Reset();
   Check("reset restores observations", c.Observations() == 0);
   double sigma = 0.0;
   c.Update(0.001, sigma);
   Check("reset restores warmup sigma (log_var re-init)", CloseEnough(sigma, 0.02, 1e-12));
  }

//+------------------------------------------------------------------+
//| TestBarAggregator — OHLC, exactly-once close, jumps, stale ticks  |
//+------------------------------------------------------------------+
void TestBarAggregator()
  {
   Print("[PHASE10] --- BarAggregator ---");
   CBarAggregator agg(300);   // M5
   AggregatedBar bar;
   datetime t0 = D'2026.08.01 00:00:00';

   Check("first tick no close", !agg.OnTick(100.0, t0 + 5));
   Check("same-bucket tick no close", !agg.OnTick(102.0, t0 + 60));
   Check("same-bucket low no close", !agg.OnTick(98.0, t0 + 120));
   Check("same-bucket close no close", !agg.OnTick(101.0, t0 + 290));
   Check("forming bar OHLC correct",
         agg.FormingBar(bar) && bar.open == 100.0 && bar.high == 102.0
         && bar.low == 98.0 && bar.close == 101.0 && bar.tick_count == 4
         && bar.time == t0);

   Check("bucket crossing closes bar", agg.OnTick(103.0, t0 + 300));
   Check("closed bar exactly-once read", agg.ClosedBar(bar));
   Check("closed bar OHLC",
         bar.open == 100.0 && bar.high == 102.0 && bar.low == 98.0
         && bar.close == 101.0 && bar.tick_count == 4 && bar.time == t0);
   Check("closed bar second read empty", !agg.ClosedBar(bar));
   Check("new bar started at crossing tick",
         agg.FormingBar(bar) && bar.open == 103.0 && bar.time == t0 + 300);

   Check("multi-bucket jump closes", agg.OnTick(105.0, t0 + 1200));
   Check("jump closed bar", agg.ClosedBar(bar) && bar.open == 103.0 && bar.close == 103.0);
   Check("jump new bar at new bucket",
         agg.FormingBar(bar) && bar.time == t0 + 1200 && bar.open == 105.0);

   Check("stale tick ignored", !agg.OnTick(1.0, t0 + 60));
   Check("stale tick left bar intact", agg.FormingBar(bar) && bar.open == 105.0);

   agg.Reset();
   Check("reset clears forming bar", !agg.FormingBar(bar));
   Check("reset: first tick re-seeds", !agg.OnTick(50.0, t0 + 2000));
   Check("reset reseeds open/bucket",
         agg.FormingBar(bar) && bar.open == 50.0 && bar.time == t0 + 1800);
  }

//+------------------------------------------------------------------+
//| TestBarAggregatorDeterminism — identical streams, identical bars  |
//+------------------------------------------------------------------+
void TestBarAggregatorDeterminism()
  {
   Print("[PHASE10] --- BarAggregator determinism ---");
   CBarAggregator a(300), b(300);
   AggregatedBar ba, bb;
   datetime base = D'2026.08.02 00:00:00';
   int closed = 0;
   for(int i = 0; i < 500; i++)
     {
      double price = 100.0 + 0.001 * (i % 97) + ((i % 11 == 0) ? 0.2 : 0.0);
      datetime t = base + i * 7;   // ~7s ticks → many M5 closes
      bool closed_a = a.OnTick(price, t);
      bool closed_b = b.OnTick(price, t);
      Check("both aggregators close in lockstep", closed_a == closed_b);
      if(closed_a)
        {
         closed++;
         Check("A closed bar read", a.ClosedBar(ba));
         Check("B closed bar read", b.ClosedBar(bb));
         Check("identical closed bar",
               ba.time == bb.time && CloseEnough(ba.open, bb.open, 1e-12)
               && CloseEnough(ba.high, bb.high, 1e-12)
               && CloseEnough(ba.low, bb.low, 1e-12)
               && CloseEnough(ba.close, bb.close, 1e-12)
               && ba.tick_count == bb.tick_count);
        }
     }
   Check("lockstep produced bars", closed > 5, "closed=" + IntegerToString(closed));
  }

//+------------------------------------------------------------------+
//| Expert initialization                                              |
//+------------------------------------------------------------------+
int OnInit()
  {
   TestGarchWarmup();
   TestGarchLocked();
   TestGarchDeterminism();
   TestBarAggregator();
   TestBarAggregatorDeterminism();
   Print(StringFormat("[PHASE10] === %d passed, %d failed ===", g_pass, g_fail));
   if(g_fail == 0)
      Print("[PHASE10] SUITE PASSED - Phase 10 step-1 complete");
   else
      Print("[PHASE10] SUITE FAILED - Phase 10 step-1 incomplete");
   return(INIT_SUCCEEDED);
  }

void OnTick() { }
